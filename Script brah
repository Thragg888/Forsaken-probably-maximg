-- ============ RAYFIELD GEN 2 LOADER (with retry + fallback) ============
local Rayfield
local RAYFIELD_URLS = {
    "https://sirius.menu/rayfield",
    "https://raw.githubusercontent.com/SiriusSoftwareLtd/Rayfield/main/source.lua",
}
do
    local ok, err
    for attempt = 1, 5 do
        for _, url in ipairs(RAYFIELD_URLS) do
            ok, err = pcall(function()
                local src = game:HttpGet(url, true)
                local fn = loadstring(src)
                assert(type(fn) == "function", "loadstring returned nil (bad source from "..url..")")
                local mod = fn()
                assert(type(mod) == "table", "module is not a table (executor likely can't follow redirect)")
                Rayfield = mod
            end)
            if ok and type(Rayfield) == "table" then break end
            warn(("[Slashsaken] Rayfield load attempt %d via %s failed: %s"):format(attempt, url, tostring(err)))
        end
        if ok and type(Rayfield) == "table" then break end
        task.wait(1)
    end
    if type(Rayfield) ~= "table" then
        local PlayerGui = game:GetService("Players").LocalPlayer:FindFirstChild("PlayerGui")
        if PlayerGui then
            local sg = Instance.new("ScreenGui"); sg.Name = "SlashsakenError"
            sg.ResetOnSpawn = false; sg.DisplayOrder = 999999; sg.Parent = PlayerGui
            local f = Instance.new("Frame")
            f.AnchorPoint = Vector2.new(0.5,0.5); f.Position = UDim2.new(0.5,0,0.5,0)
            f.Size = UDim2.new(0,360,0,120); f.BackgroundColor3 = Color3.fromRGB(30,0,0)
            f.BorderSizePixel = 0; f.Parent = sg
            local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0,10); c.Parent = f
            local t = Instance.new("TextLabel")
            t.Size = UDim2.new(1,-20,1,-20); t.Position = UDim2.new(0,10,0,10)
            t.BackgroundTransparency = 1; t.TextColor3 = Color3.new(1,1,1)
            t.Font = Enum.Font.GothamMedium; t.TextSize = 14; t.TextWrapped = true
            t.Text = "Slashsaken: Failed to load Rayfield Gen 2 after 5 attempts. sirius.menu may be down, or your executor cannot follow the 302 redirect. Try a different executor (Delta/Fluxus/Wave)."
            t.Parent = f
        end
        error("[Slashsaken] Rayfield load failed: " .. tostring(err))
    end
end

