MakeToggle(BlockGB, "AutoBlock", {
    Title = "Auto Block",
    Desc = "Only fires on blockable basic attacks while in facing circle. 27s cooldown.",
    Default = false,
    CustomSetup = function()
        if not KillersFolder then return end

        local BlockableAttacks = {"slash", "enragedslash", "stab", "attack", "punch", "swing", "golemslash"}
        local LEAD, COOLDOWN, SWEEP_WINDOW, SWEEP_MUL = 0.02, 27, 0.55, 2.5
        local lastBlockAt = 0

        local function SetupKiller(Killer)
            if Players:GetPlayerFromCharacter(Killer) == LocalPlayer then return end

            local Hum = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid", 5)
            if not Hum then return end
            local Anim = Hum:FindFirstChildOfClass("Animator") or Hum:WaitForChild("Animator", 5)
            if not Anim then return end

            local remote = Network and Network:FindFirstChildOfClass("RemoteEvent")

            local function DoBlock(currentTrack)
                if not Killer or not Killer.Parent then return end
                if not (LocalCharacter and LocalCharacter.Parent == SurvivorsFolder) then return end

                local trigName = "?"
                if currentTrack and currentTrack.Animation then
                    local curName = GetAnimationType(currentTrack.Animation.AnimationId)
                    if not curName or not table.find(BlockableAttacks, curName:lower()) then return end
                    trigName = curName
                end
                local kr = Killer:FindFirstChild("HumanoidRootPart")
                if not (kr and LocalRoot) then return end
                if (kr.Position - LocalRoot.Position).Magnitude > detectionRange then return end
                if not isFacing(LocalRoot, kr) then return end

                local btn = MainUI and MainUI:FindFirstChild("AbilityContainer") and MainUI.AbilityContainer:FindFirstChild("Block")
                if btn then
                    local cdEl = btn:FindFirstChild("CooldownTime")
                    if cdEl and cdEl.Text ~= "" and cdEl.Text ~= "0" then return end
                end

                if tick() - lastBlockAt < COOLDOWN then return end
                lastBlockAt = tick()

                if btn and btn.MouseButton1Click and firesignalFn then pcall(firesignalFn, btn.MouseButton1Click) end
                if remote then
                    pcall(function() remote:FireServer("UseActorAbility", {"Block"}) end)
                    pcall(function() remote:FireServer("UseActorAbility", "Block") end)
                end

                if AutoBlock_Debug then
                    pcall(function()
                        StarterGui:SetCore("SendNotification", {
                            Title = "Auto Block Fired",
                            Text = "On: " .. trigName .. " · " .. Killer.Name,
                            Duration = 2,
                        })
                    end)
                end

                task.spawn(function() StartHDT(Killer) end)
            end

            local selfParams = OverlapParams.new()
            selfParams.FilterType = Enum.RaycastFilterType.Include
            selfParams.MaxParts = 1

            Track(Anim.AnimationPlayed:Connect(function(track)
                if not GetValue("AutoBlock") then return end

                local animName = GetAnimationType(track.Animation and track.Animation.AnimationId or "")
                if not animName or not table.find(BlockableAttacks, animName:lower()) then return end

                if not LocalCharacter or LocalCharacter.Parent ~= SurvivorsFolder then return end
                if not LocalCharacter:FindFirstChild("QueryHitbox") then return end

                local kr = Killer:FindFirstChild("HumanoidRootPart")
                if not (kr and LocalRoot) then return end
                if (kr.Position - LocalRoot.Position).Magnitude > detectionRange then return end
                if not isFacing(LocalRoot, kr) then return end

                task.delay(LEAD, function() DoBlock(track) end)

                local stop = tick() + math.min(track.Length > 0 and track.Length or SWEEP_WINDOW, SWEEP_WINDOW)
                local conn
                conn = Track(RunService.PreSimulation:Connect(function()
                    if tick() > stop or not GetValue("AutoBlock") or not conn then
                        if conn then conn:Disconnect() end; return
                    end
                    if not LocalCharacter or not LocalCharacter:FindFirstChild("QueryHitbox") then
                        if conn then conn:Disconnect() end; return
                    end
                    local kh = Killer:FindFirstChild("QueryHitbox")
                    if not kh then return end
                    selfParams.FilterDescendantsInstances = {LocalCharacter.QueryHitbox}
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(5.2, 6, 5.65) * SWEEP_MUL
                    p.CFrame = kh.CFrame * CFrame.new(0, 0, -3.5)
                    p.CanCollide = false; p.Anchored = true; p.CastShadow = false; p.Transparency = 1
                    p.Parent = Hitboxes or workspace
                    local hit = #workspace:GetPartsInPart(p, selfParams) > 0
                    p:Destroy()
                    if hit then DoBlock(track) end
                end))
            end))
        end

        Track(KillersFolder.ChildAdded:Connect(function(k) task.wait(0.5); SetupKiller(k) end))
        for _, k in KillersFolder:GetChildren() do task.spawn(SetupKiller, k) end
    end,
})

