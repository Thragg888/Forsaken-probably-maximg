function PopulateAnimations()
    if not IsRequireSupported then
        warn("[Larp Hub] Require not supported — Auto Block and Survivor Aim will not fire.")
        return
    end
    if not (KillerAssets and SurvivorAssets and SkinsAssets) then
        warn("[Larp Hub] Asset folders missing — cannot populate animations.")
        return
    end

    local waited = 0
    while waited < 30 do
        if KillerAssets:FindFirstChild("Config", true) then break end
        task.wait(0.5)
        waited = waited + 0.5
    end

    local configs = {}
    for _, v in KillerAssets:QueryDescendants("ModuleScript#Config") do table.insert(configs, v) end
    for _, v in SurvivorAssets:QueryDescendants("ModuleScript#Config") do table.insert(configs, v) end
    for _, v in SkinsAssets:QueryDescendants("ModuleScript#Config") do table.insert(configs, v) end

    for _, cfg in configs do
        if not cfg.Parent or cfg.Parent:IsA("Model") then continue end
        local ok, data = pcall(require, cfg)
        if not ok or type(data) ~= "table" or not data.Animations then continue end
        local charName = cfg.Parent and cfg.Parent.Name or "?"
        if data.DisplayName and data.DisplayName:find("Milestone") then
            charName = string.format("%s %s", cfg.Parent and cfg.Parent.Parent and cfg.Parent.Parent.Name or charName, data.DisplayName:gsub("Milestone ", ""))
        end
        AllAnimations[charName] = data.Animations

        for animName, animId in data.Animations do
            if type(animId) == "table" then
                for _, subId in animId do
                    if type(subId) == "string" then
                        local num = subId:match("%d+")
                        if num then AnimationIdToName[num] = animName end
                    end
                end
            elseif type(animId) == "string" then
                local num = animId:match("%d+")
                if num then AnimationIdToName[num] = animName end
            end
        end
    end

    local count = 0
    for _ in pairs(AnimationIdToName) do count = count + 1 end
    print(string.format("[Larp Hub] Loaded %d animation IDs from %d configs.", count, #configs))
    if count == 0 then
        warn("[Larp Hub] Could not load animation configs — Auto Block and Survivor Aim will not fire.")
        pcall(function()
            StarterGui:SetCore("SendNotification", {
                Title = "Larp Hub Warning",
                Text = "Animation configs failed to load. Auto Block and Survivor Aim are inactive.",
                Duration = 10,
            })
        end)
    end
end

