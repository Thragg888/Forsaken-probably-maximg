-- ============================================================
local BlockGB = Tabs.AutoBlock:Section({Title="Blocking", Opened=true})
local CircleGB = Tabs.AutoBlock:Section({Title="Facing Circle", Opened=true})

MakeToggle(BlockGB, "AutoBlock", {
    Title="Auto Block",
    Desc="Hybrid: attribute trigger + M1 animation-name filter + hitbox fallback. 27s global cooldown. M1-only when configs load.",
    Default=false,
    CustomSetup=function()
        if not KillersFolder then return end
        local LEAD, COOLDOWN, SWEEP_WINDOW, SWEEP_MUL = 0.02, 27, 0.55, 2.5
        local ATTRIBUTE_WINDOW = 0.25
        local lastBlockAt = 0

        local killerState = {}
        local function getState(k)
            killerState[k] = killerState[k] or {lastAbility=0, lastUsed=0, pending=false, pendingAt=0, lastAnimName=nil, lastAnimAt=0}
            return killerState[k]
        end

        local function DoBlock(killer, reason)
            if not killer or not killer.Parent then return end
            if not (LocalCharacter and LocalCharacter.Parent == SurvivorsFolder) then return end
            local kr = killer:FindFirstChild("HumanoidRootPart")
            if not (kr and LocalRoot) then return end
            if (kr.Position - LocalRoot.Position).Magnitude > detectionRange then return end
            if not isFacing(LocalRoot, kr) then return end

            local btn = MainUI and MainUI:FindFirstChild("AbilityContainer") and MainUI.AbilityContainer:FindFirstChild("Block")
            if btn then
                local cdEl = btn:FindFirstChild("CooldownTime")
                if cdEl and cdEl.Text ~= "" and cdEl.Text ~= "0" then return end
            end
            if tick() - lastBlockAt < COOLDOWN then return end
            lastBlockAt = tick()

            if btn and btn.MouseButton1Click and firesignalFn then pcall(firesignalFn, btn.MouseButton1Click) end
            local remote = Network and Network:FindFirstChildOfClass("RemoteEvent")
            if remote then
                pcall(function() remote:FireServer("UseActorAbility", {"Block"}) end)
                pcall(function() remote:FireServer("UseActorAbility", "Block") end)
            end

            if AutoBlock_Debug then
                pcall(function()
                    StarterGui:SetCore("SendNotification", {Title="Auto Block", Text="Trigger: "..tostring(reason).." · "..killer.Name, Duration=2})
                end)
            end
            -- HDT only on confirmed block (triggered by block-success sound, see SetupBlockSuccessMonitor)
        end

        local function SetupKiller(Killer)
            if Players:GetPlayerFromCharacter(Killer) == LocalPlayer then return end
            local Hum = Killer:FindFirstChildOfClass("Humanoid") or Killer:WaitForChild("Humanoid", 5)
            if not Hum then return end
            local Anim = Hum:FindFirstChildOfClass("Animator") or Hum:WaitForChild("Animator", 5)
            if not Anim then return end

            local st = getState(Killer)
            local selfParams = OverlapParams.new()
            selfParams.FilterType = Enum.RaycastFilterType.Include
            selfParams.MaxParts = 1

            -- Track most recent animation name on this killer
            Track(Anim.AnimationPlayed:Connect(function(track)
                local name = GetAnimationType(track.Animation and track.Animation.AnimationId or "")
                if name then
                    st.lastAnimName = name:lower():gsub("%s", "")
                    st.lastAnimAt = tick()
                end
            end))

            -- Attribute polling: fast trigger
            Track(RunService.Heartbeat:Connect(function()
                if not GetValue("AutoBlock") then return end
                local alu = Killer:GetAttribute("AbilityLastUsed") or 0
                local au = Killer:GetAttribute("AbilitiesUsed") or 0

                if st.lastAbility == 0 then st.lastAbility = alu; st.lastUsed = au; return end

                local abilityInc = alu > st.lastAbility
                local usedInc = au > st.lastUsed
                st.lastAbility = alu; st.lastUsed = au

                if not abilityInc then return end
                if usedInc then return end  -- bait, skip

                -- Confirmed ability use (not bait). Check M1 by animation name.
                local now = tick()
                local animName = st.lastAnimName
                local animFresh = (now - st.lastAnimAt) < 0.15

                if AutoBlock_AnimationMode and animName and animFresh then
                    if BlockableAttacks[animName] then
                        -- Tier 1: attribute + M1 animation name (highest confidence)
                        DoBlock(Killer, "attr+M1:"..animName)
                    else
                        -- Tier 2: attribute + known non-M1 animation -> skip
                        if AutoBlock_Debug then
                            pcall(function()
                                StarterGui:SetCore("SendNotification", {Title="Auto Block Skip", Text="Non-M1: "..animName, Duration=2})
                            end)
                        end
                    end
                else
                    -- Tier 3: attribute fired but no fresh animation name yet
                    -- Wait ATTRIBUTE_WINDOW for animation to resolve
                    st.pending = true; st.pendingAt = now
                    task.spawn(function()
                        task.wait(ATTRIBUTE_WINDOW)
                        if not st.pending or tick() - st.pendingAt < ATTRIBUTE_WINDOW - 0.02 then return end
                        st.pending = false
                        -- No animation resolved within window
                        if AutoBlock_AnimationMode and next(AnimationIdToName) then
                            -- Configs loaded, animation should have resolved -> skip (likely M2 or config mismatch)
                            return
                        end
                        if AutoBlock_HitboxFallback then
                            -- Configs failed -> hitbox sweep fallback
                            local kh = Killer:FindFirstChild("QueryHitbox")
                            if not kh then return end
                            selfParams.FilterDescendantsInstances = {LocalCharacter and LocalCharacter:FindFirstChild("QueryHitbox")}
                            if not selfParams.FilterDescendantsInstances[1] then return end
                            local p = Instance.new("Part")
                            p.Size = Vector3.new(5.2,6,5.65) * SWEEP_MUL
                            p.CFrame = kh.CFrame * CFrame.new(0,0,-3.5)
                            p.CanCollide=false; p.Anchored=true; p.CastShadow=false; p.Transparency=1
                            p.Parent = Hitboxes or workspace
                            local hit = #workspace:GetPartsInPart(p, selfParams) > 0
                            p:Destroy()
                            if hit then DoBlock(Killer, "attr+hitbox-fallback") end
                        end
                    end)
                end
            end))

            -- Animation-only trigger (works even if attribute is slow/broken)
            Track(Anim.AnimationPlayed:Connect(function(track)
                if not GetValue("AutoBlock") then return end
                if not AutoBlock_AnimationMode then return end
                local name = GetAnimationType(track.Animation and track.Animation.AnimationId or "")
                if not name or not BlockableAttacks[name:lower():gsub("%s", "")] then return end
                if not LocalCharacter or LocalCharacter.Parent ~= SurvivorsFolder then return end
                if not LocalCharacter:FindFirstChild("QueryHitbox") then return end
                local kr = Killer:FindFirstChild("HumanoidRootPart")
                if not (kr and LocalRoot) then return end
                if (kr.Position - LocalRoot.Position).Magnitude > detectionRange then return end
                if not isFacing(LocalRoot, kr) then return end

                task.delay(LEAD, function() DoBlock(Killer, "anim:"..name) end)
                local stop = tick() + math.min(track.Length > 0 and track.Length or SWEEP_WINDOW, SWEEP_WINDOW)
                local conn
                conn = Track(RunService.PreSimulation:Connect(function()
                    if tick() > stop or not GetValue("AutoBlock") or not conn then
                        if conn then conn:Disconnect() end; return
                    end
                    if not LocalCharacter or not LocalCharacter:FindFirstChild("QueryHitbox") then
                        if conn then conn:Disconnect() end; return
                    end
                    local kh = Killer:FindFirstChild("QueryHitbox")
                    if not kh then return end
                    selfParams.FilterDescendantsInstances = {LocalCharacter.QueryHitbox}
                    local p = Instance.new("Part")
                    p.Size = Vector3.new(5.2,6,5.65) * SWEEP_MUL
                    p.CFrame = kh.CFrame * CFrame.new(0,0,-3.5)
                    p.CanCollide=false; p.Anchored=true; p.CastShadow=false; p.Transparency=1
                    p.Parent = Hitboxes or workspace
                    local hit = #workspace:GetPartsInPart(p, selfParams) > 0
                    p:Destroy()
                    if hit then DoBlock(Killer, "anim-sweep:"..name) end
                end))
            end))
        end

        Track(KillersFolder.ChildAdded:Connect(function(k) task.wait(0.5); SetupKiller(k) end))
        for _, k in KillersFolder:GetChildren() do task.spawn(SetupKiller, k) end

        -- Block-success sound monitor -> HDT only on confirmed block
        local function MonitorBlockSuccess(char)
            if not char then return end
            local function check(snd)
                if not snd:IsA("Sound") then return end
                local sid = tostring(snd.SoundId):match("%d+")
                if sid and BlockSuccessSounds[sid] then
                    -- Block actually succeeded -> trigger HDT
                    local killer = getNearestKillerModel()
                    if killer then task.spawn(function() StartHDT(killer) end) end
                end
            end
            for _, s in char:GetDescendants() do check(s) end
            Track(char.DescendantAdded:Connect(check))
        end
        if LocalCharacter then MonitorBlockSuccess(LocalCharacter) end
        Track(LocalPlayer.CharacterAdded:Connect(function(c) task.wait(0.5); MonitorBlockSuccess(c) end))
    end,
})

