local function MakeToggle(parent, name, data)
    local inst = Instance.new("BoolValue")
    inst.Name = name
    inst.Value = data.Default or false
    inst:SetAttribute("DisplayTitle", data.Title or name)
    inst:SetAttribute("DisplayDescription", data.Desc or "")
    inst.Parent = PlusFolderSettings
    data.Instance = inst
    Values[name] = inst

    if data.ScriptFunction then task.spawn(function() pcall(data.ScriptFunction, data, inst.Value, true) end) end

    local updating = false
    local cb = function(v)
        if updating or inst.Value == v then return end
        updating = true; inst.Value = v
        if data.ScriptFunction then pcall(data.ScriptFunction, data, v, false) end
        updating = false
    end

    parent:Toggle({
        Title = inst:GetAttribute("DisplayTitle"),
        Desc  = inst:GetAttribute("DisplayDescription"),
        Value = inst.Value,
        Callback = cb,
    })

    Track(inst:GetPropertyChangedSignal("Value"):Connect(function()
        if updating then return end
        updating = true
        if data.ScriptFunction then pcall(data.ScriptFunction, data, inst.Value, false) end
        updating = false
    end))

    if data.CustomSetup then task.spawn(function() pcall(data.CustomSetup, data) end) end
    if data.OnLoop then Track(RunService.Heartbeat:Connect(function() pcall(data.OnLoop, data) end)) end
    if data.CharacterAdded then
        Track(LocalPlayer.CharacterAdded:Connect(function()
            task.delay(0, function() pcall(data.CharacterAdded, data) end)
        end))
    end
end

